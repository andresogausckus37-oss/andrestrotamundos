          {ocupadoRenovacion ? "Enviando comprobante..." : "Ya pagué · enviar comprobante"}
        </button>
      </>}
      {pedido.estado === "en_revision" && <p className="text-slate-600">Estamos verificando el comprobante. No hace falta enviarlo otra vez.</p>}
